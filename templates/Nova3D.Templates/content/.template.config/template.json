{
  "$schema": "http://json.schemastore.org/template",
  "author": "Nova3D",
  "classifications": [ "Game", "MonoGame", "3D" ],
  "identity": "Nova3D.Templates.Game",
  "name": "Nova3D Game",
  "shortName": "nova3d",
  "sourceName": "Nova3DGame",
  "defaultName": "Nova3DGame",
  "preferNameDirectory": true,
  "tags": {
    "language": "C#",
    "type": "project"
  },
  "symbols": {
    "physics": {
      "type": "parameter",
      "datatype": "bool",
      "defaultValue": "false",
      "description": "Include the optional Nova3D.Physics.Bepu module and physics starter scene."
    },
    "ui": {
      "type": "parameter",
      "datatype": "bool",
      "defaultValue": "false",
      "description": "Include the optional Nova3D.UI.Gum module and UI starter overlay."
    }
  },
  "sources": [
    {
      "modifiers": [
        {
          "condition": "(!ui)",
          "exclude": [ "Game/UiOverlay.cs" ]
        }
      ]
    }
  ],
  "primaryOutputs": [
    { "path": "Nova3DGame.csproj" }
  ]
}
