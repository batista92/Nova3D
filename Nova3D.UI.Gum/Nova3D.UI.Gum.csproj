<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PackageId>Nova3D.UI.Gum</PackageId>
    <Version>0.1.0</Version>
    <Authors>Bruno Batista</Authors>
    <Copyright>Copyright © 2026 Bruno Batista</Copyright>
    <Description>Optional Gum game UI integration for Nova3D.</Description>
    <PackageTags>monogame;ui;gum;hud;menus;nova3d</PackageTags>
    <PackageReadmeFile>PACKAGE.md</PackageReadmeFile>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/batista92/Nova3D</PackageProjectUrl>
    <RepositoryType>git</RepositoryType>
    <RepositoryUrl>https://github.com/batista92/Nova3D.git</RepositoryUrl>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Nova3D\Nova3D.csproj" />
    <PackageReference Include="Gum.MonoGame" Version="2026.9.2.1" />
    <None Include="PACKAGE.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
