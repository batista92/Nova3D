<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\Nova3D\Nova3D.csproj" />
    <PackageReference Include="MonoGame.Framework.DesktopGL" Version="3.8.4.1" />
    <PackageReference Include="MonoGame.Content.Builder.Task" Version="3.8.4.1" />
    <Compile Include="..\Shared\SampleMeshFactory.cs" Link="Shared\SampleMeshFactory.cs" />
    <MonoGameContentReference Include="Content\Content.mgcb" />
    <None Update="Assets\**\*" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\Docs\Examples\Scenes\Prefabs\house.scene.json"
          Link="Assets\Prefabs\house.scene.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\Docs\Examples\Scenes\Prefabs\roof.scene.json"
          Link="Assets\Prefabs\roof.scene.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
