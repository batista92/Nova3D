{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nova3d.dev/schemas/nova3d.visual-capture.1.schema.json",
  "title": "Nova3D visual capture metadata v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format", "version", "scene", "image", "width", "height", "seed",
    "fixedTimeStepTicks", "warmupFrames", "captureFrame", "backend",
    "graphicsAdapter", "graphicsProfile", "backBufferFormat",
    "depthStencilFormat", "multiSampleCount", "operatingSystem",
    "processArchitecture"
  ],
  "properties": {
    "format": { "const": "nova3d.visual-capture" },
    "version": { "const": 1 },
    "scene": { "type": "string", "minLength": 1 },
    "image": { "type": "string", "pattern": "^[^/\\\\]+\\.png$" },
    "width": { "type": "integer", "minimum": 1 },
    "height": { "type": "integer", "minimum": 1 },
    "seed": { "type": "integer" },
    "fixedTimeStepTicks": { "type": "integer", "minimum": 1 },
    "warmupFrames": { "type": "integer", "minimum": 0 },
    "captureFrame": { "type": "integer", "minimum": 1 },
    "backend": { "type": "string", "minLength": 1 },
    "graphicsAdapter": { "type": "string", "minLength": 1 },
    "graphicsProfile": { "type": "string", "minLength": 1 },
    "backBufferFormat": { "type": "string", "minLength": 1 },
    "depthStencilFormat": { "type": "string", "minLength": 1 },
    "multiSampleCount": { "type": "integer", "minimum": 0 },
    "operatingSystem": { "type": "string", "minLength": 1 },
    "processArchitecture": { "type": "string", "minLength": 1 }
  }
}
