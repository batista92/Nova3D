{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/batista92/Nova3D/schemas/nova3d.visual-baseline.1.schema.json",
  "title": "Nova3D visual regression baseline",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "version",
    "scene",
    "captureVersion",
    "image",
    "captureMetadata",
    "imageSha256",
    "captureMetadataSha256",
    "channelTolerance",
    "maxDifferentPixelRatio",
    "environment"
  ],
  "properties": {
    "format": { "const": "nova3d.visual-baseline" },
    "version": { "const": 1 },
    "scene": { "type": "string", "minLength": 1 },
    "captureVersion": { "const": 1 },
    "image": { "type": "string", "minLength": 1 },
    "captureMetadata": { "type": "string", "minLength": 1 },
    "imageSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "captureMetadataSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "channelTolerance": { "type": "integer", "minimum": 0, "maximum": 255 },
    "maxDifferentPixelRatio": { "type": "number", "minimum": 0, "maximum": 1 },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "backend",
        "graphicsAdapter",
        "graphicsProfile",
        "backBufferFormat",
        "depthStencilFormat",
        "multiSampleCount",
        "operatingSystem",
        "processArchitecture"
      ],
      "properties": {
        "backend": { "type": "string" },
        "graphicsAdapter": { "type": "string" },
        "graphicsProfile": { "type": "string" },
        "backBufferFormat": { "type": "string" },
        "depthStencilFormat": { "type": "string" },
        "multiSampleCount": { "type": "integer", "minimum": 0 },
        "operatingSystem": { "type": "string" },
        "processArchitecture": { "type": "string" }
      }
    }
  }
}
