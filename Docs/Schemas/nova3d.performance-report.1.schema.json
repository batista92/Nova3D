{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nova3d.dev/schemas/nova3d.performance-report.1.schema.json",
  "title": "Nova3D performance report version 1",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "version", "scene", "width", "height", "warmupFrames", "sampleFrames", "backend", "graphicsAdapter", "graphicsProfile", "multiSampleCount", "operatingSystem", "processArchitecture", "metrics"],
  "properties": {
    "format": { "const": "nova3d.performance-report" },
    "version": { "const": 1 },
    "scene": { "type": "string", "minLength": 1 },
    "width": { "type": "integer", "minimum": 1 },
    "height": { "type": "integer", "minimum": 1 },
    "warmupFrames": { "type": "integer", "minimum": 1 },
    "sampleFrames": { "type": "integer", "minimum": 1 },
    "backend": { "type": "string", "minLength": 1 },
    "graphicsAdapter": { "type": "string", "minLength": 1 },
    "graphicsProfile": { "type": "string", "minLength": 1 },
    "multiSampleCount": { "type": "integer", "minimum": 0 },
    "operatingSystem": { "type": "string", "minLength": 1 },
    "processArchitecture": { "type": "string", "minLength": 1 },
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["frameIntervalMilliseconds", "updateCpuMilliseconds", "drawCpuMilliseconds", "shadowCpuMilliseconds", "worldCpuMilliseconds", "postCpuMilliseconds", "drawCalls", "triangles", "shadowTriangles", "shadowDrawCalls", "instances", "visibleChunks", "candidates"],
      "properties": {
        "frameIntervalMilliseconds": { "$ref": "#/$defs/timing" },
        "updateCpuMilliseconds": { "$ref": "#/$defs/timing" },
        "drawCpuMilliseconds": { "$ref": "#/$defs/timing" },
        "shadowCpuMilliseconds": { "$ref": "#/$defs/timing" },
        "worldCpuMilliseconds": { "$ref": "#/$defs/timing" },
        "postCpuMilliseconds": { "$ref": "#/$defs/timing" },
        "drawCalls": { "$ref": "#/$defs/count" },
        "triangles": { "$ref": "#/$defs/count" },
        "shadowTriangles": { "$ref": "#/$defs/count" },
        "shadowDrawCalls": { "$ref": "#/$defs/count" },
        "instances": { "$ref": "#/$defs/count" },
        "visibleChunks": { "$ref": "#/$defs/count" },
        "candidates": { "$ref": "#/$defs/count" }
      }
    }
  },
  "$defs": {
    "timing": {
      "type": "object",
      "additionalProperties": false,
      "required": ["average", "p50", "p95", "maximum"],
      "properties": {
        "average": { "type": "number", "minimum": 0 },
        "p50": { "type": "number", "minimum": 0 },
        "p95": { "type": "number", "minimum": 0 },
        "maximum": { "type": "number", "minimum": 0 }
      }
    },
    "count": {
      "type": "object",
      "additionalProperties": false,
      "required": ["average", "maximum"],
      "properties": {
        "average": { "type": "number", "minimum": 0 },
        "maximum": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
