<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PackageId>Nova3D</PackageId>
    <Version>0.3.0</Version>
    <Authors>Bruno Batista</Authors>
    <Copyright>Copyright © 2026 Bruno Batista</Copyright>
    <Description>3D rendering and world toolkit for MonoGame.</Description>
    <PackageTags>monogame;3d;rendering;terrain;gltf;audio;persistence</PackageTags>
    <PackageReadmeFile>PACKAGE.md</PackageReadmeFile>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/batista92/Nova3D</PackageProjectUrl>
    <RepositoryType>git</RepositoryType>
    <RepositoryUrl>https://github.com/batista92/Nova3D.git</RepositoryUrl>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MonoGame.Framework.DesktopGL" Version="3.8.4.1" />
    <None Include="PACKAGE.md" Pack="true" PackagePath="\" />
    <None Include="Shaders\**\*.fx" Pack="true"
          PackagePath="contentFiles\any\any\Shaders" />
    <None Include="..\Docs\Schemas\nova3d.scene.1.schema.json" Pack="true"
          PackagePath="contentFiles\any\any\Schemas" />
    <None Include="..\Docs\Schemas\nova3d.visual-capture.1.schema.json" Pack="true"
          PackagePath="contentFiles\any\any\Schemas" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="SkinningSpike" />
    <InternalsVisibleTo Include="AudioContractTests" />
  </ItemGroup>

</Project>
